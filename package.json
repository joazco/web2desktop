{
  "name": "web2desktop",
  "productName": "Web2Desktop",
  "version": "1.0.0",
  "web2desktopVersion": "1.0.1",
  "description": "Web2Desktop is an Electron framework designed to quickly turn any web interface into a desktop application.",
  "main": "./dist/main.js",
  "scripts": {
    "start": "electron-forge start",
    "build": "tsc -p .",
    "dev": "concurrently -k \"npm:dev:ts\" \"npm:dev:electron\"",
    "dev:ts": "tsc -w -p .",
    "dev:electron": "wait-on dist/main.js && nodemon --delay 800ms --watch dist --watch www --watch splash --watch demo --ext js,json,html,css,png,jpg,svg --exec \"electron .\"",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "make:demo": "rimraf \"www/*\" --glob && cpy \"demo/**\" www --parents && npm run make",
    "publish": "npm run build && electron-forge publish",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "keywords": [],
  "author": {
    "name": "Jordan AZOULAY",
    "email": "jazoulay@joazco.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-msix": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-wix": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.1.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "concurrently": "^9.2.1",
    "cpy-cli": "^5.0.0",
    "electron": "40.10.6",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "nodemon": "^3.1.11",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "steamworks.js": "^0.4.0"
  }
}
